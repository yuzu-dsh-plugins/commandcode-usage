{
  "name": "dsh-commandcode-plan-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Command Code plan usage in the sidebar foot beside Settings: 5-hour, weekly and monthly windows with reset times and plan status.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuzu-dsh-plugins/commandcode-usage.git"
  },
  "bugs": {
    "url": "https://github.com/yuzu-dsh-plugins/commandcode-usage/issues"
  },
  "homepage": "https://github.com/yuzu-dsh-plugins/commandcode-usage#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "commandcode",
    "plan",
    "usage",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
